{
  "description": "Keyless sigstore sign-then-verify with --ignore-paths (§4.1, §6.2)",
  "method": "sigstore",
  "model": "models/simple",
  "requires_ci": true,
  "sign": {
    "identity_token_env": "SIGSTORE_ID_TOKEN",
    "use_staging": true
  },
  "verify": {
    "identity": "${SIGSTORE_IDENTITY}",
    "identity_provider": "https://accounts.google.com",
    "ignore_paths": [
      "ignore-me"
    ],
    "use_staging": true
  },
  "expected_signed_files": [
    "signme-1",
    "signme-2"
  ]
}
